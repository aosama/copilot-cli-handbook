{
  "name": "copilot-cli-handbook",
  "version": "1.0.0",
  "description": "A single source for all there is to know about copilot CLI",
  "main": "index.js",
  "engines": {
    "node": ">=24.14.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "prettier --check . && npm run lint:md",
    "lint:md": "markdownlint-cli2 \"README.md\" \".github/**/*.md\" \"src/**/*.md\"",
    "lint:fix": "prettier --write .",
    "format": "prettier --write .",
    "prepare": "husky || true",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aosama/copilot-cli-handbook.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/aosama/copilot-cli-handbook/issues"
  },
  "homepage": "https://github.com/aosama/copilot-cli-handbook#readme",
  "lint-staged": {
    "*.{js,mjs,ts,astro,json,css}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write",
      "markdownlint-cli2"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/parser": "^8.57.0",
    "astro": "^6.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.21.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1"
  }
}
