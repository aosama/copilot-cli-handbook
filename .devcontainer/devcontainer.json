{
  "name": "Copilot CLI Handbook",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",
  "features": {
    "ghcr.io/devcontainers/features/node:2.0.0": {
      "version": "24.14.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm install && npm install -g @github/copilot@latest",
  "forwardPorts": [4321],
  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode", "mutantdino.resourcemonitor"]
    }
  }
}
